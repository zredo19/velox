{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velox",
  "version": "0.1.0",
  "identifier": "dev.velox.ade",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velox",
        "width": 1320,
        "height": 840,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
